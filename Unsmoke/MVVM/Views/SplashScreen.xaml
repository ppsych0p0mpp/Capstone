<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Unsmoke.MVVM.Views.SplashScreen"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Title="SplashScreen"
             BackgroundColor="#f2f0ef">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFC000" Offset="0.0"/>
            <GradientStop Color="#FF8800" Offset="0.5"/>
            <GradientStop Color="#FF3300" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout VerticalOptions="Center">

        <Border x:Name="logoImage"
                WidthRequest="200"
                HeightRequest="200"
                BackgroundColor="#262625"
                Stroke="Transparent">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="50"/>
            </Border.StrokeShape>
            <Image Source="logo"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   WidthRequest="250"/>
        </Border>
       
        <Label Text="Smoke-Free"
               TextColor="White"
               FontAttributes="Bold"
               FontSize="30"
               Margin="0,10,0,0"
               VerticalOptions="Center"
               HorizontalOptions="Center"/>
        
        <Label Text="Your journey to a healthier life"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               HorizontalTextAlignment="Center"
               Margin="0,-5,0,0"
               VerticalTextAlignment="Center"
               FontSize="18"
               TextColor="White"/>

        <HorizontalStackLayout x:Name="dotLayout"
                           HorizontalOptions="Center"
                           Margin="0,24,0,0"/>
    </VerticalStackLayout>
</ContentPage>